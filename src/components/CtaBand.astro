---
interface Props {
  image?: string;
  alt?: string;
}

const {
  image = "/images/tanker.jpg",
  alt = "Endüstriyel lojistik ve yakıt dağıtımı",
} = Astro.props;
---

<section class="cta-band">
  <div class="bg">
    <img src={image} alt={alt} loading="lazy" />
  </div>
  <div class="overlay"></div>
  <div class="wrap cta-inner">
    <span class="kicker">Teklif ve iletişim</span>
    <h2>İhtiyacınız için doğru çözümü birlikte belirleyelim.</h2>
    <p>
      Ürün ve hizmetlerimiz hakkında bilgi almak veya teklif talep etmek için
      bizimle iletişime geçin. Talebinizi netleştirdikten sonra size dönüş
      sağlanır.
    </p>
    <div class="hero-actions">
      <a class="btn btn-amber" href="/iletisim">Teklif Al</a>
      <a class="btn btn-ghost" href="/iletisim">İletişime Geç</a>
    </div>
  </div>
</section>
