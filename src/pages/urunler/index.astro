---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";
---

<Base
  title="Ürünler | CNK Endüstriyel"
  description="CNK Endüstriyel’in kayıtlı faaliyet alanı sıvı yakıtlar ve ilgili ürünlerin toptan ticaretidir. Akaryakıt ve endüstriyel ürün gruplarını inceleyin."
  path="/urunler"
  hero
>
  <PageHero
    kicker="Ürünler"
    title="Ürün ve çözüm grupları"
    text="Ürün başlıkları, şirketin tescilli unvanı ve NACE 46.81.01 faaliyet tanımıyla uyumlu şekilde gruplanmıştır. Güncel katalog talep üzerine paylaşılır."
    image="/images/tanks.jpg"
    alt="Yakıt depolama tankları"
  />

  <section>
    <article class="catalog-item">
      <div class="media">
        <img src="/images/hero.jpg" alt="Akaryakıt depolama sahası" loading="lazy" />
      </div>
      <div class="catalog-copy">
        <span class="num" style="color: var(--amber); font-weight: 700; letter-spacing: 0.16em;">01</span>
        <h2>Akaryakıt ürünleri</h2>
        <p>
          Sıvı yakıtların toptan ticareti, resmi faaliyet sınıfımızın
          merkezindedir. Motorin, benzin ve fuel oil gibi ürün grupları bu
          sınıfın sözlük kapsamındadır; mevcut tedarik listesi ayrıca teyit
          edilir.
        </p>
        <a class="text-link" href="/urunler/akaryakit" style="margin-top: 24px;">
          Akaryakıt ürünlerini incele →
        </a>
      </div>
    </article>
    <article class="catalog-item">
      <div class="media">
        <img
          src="/images/pipes.jpg"
          alt="Endüstriyel proses ve boru hatları"
          loading="lazy"
        />
      </div>
      <div class="catalog-copy">
        <span class="num" style="color: var(--amber); font-weight: 700; letter-spacing: 0.16em;">02</span>
        <h2>Endüstriyel ürünler</h2>
        <p>
          Şirket unvanı, akaryakıt ürünlerinin yanı sıra endüstriyel ürün
          dağıtımı ve pazarlamasını da kapsar. İlgili ürün grubu işletme
          ihtiyacına göre değerlendirilir.
        </p>
        <a class="text-link" href="/urunler/endustriyel" style="margin-top: 24px;">
          Endüstriyel ürünleri incele →
        </a>
      </div>
    </article>
  </section>

  <CtaBand />
</Base>
